# ============================================================================
# NegotiAI v0 - API Keys Configuration
# ============================================================================
#
# IMPORTANT: This is an example file. Copy this to .env and fill in your real API keys.
#
# See API_KEYS_SETUP.md for detailed instructions on how to get these keys.
#
# ============================================================================

# ============================================================================
# MISTRAL AI (REQUIRED)
# ============================================================================
# Get your key from: https://console.mistral.ai/
# Used for: Research, opponent AI, tactical suggestions, strategy generation
#
MISTRAL_API_KEY=your_mistral_key_here

# ============================================================================
# ELEVENLABS (REQUIRED for voice features)
# ============================================================================
# Get your key from: https://elevenlabs.io/
# Used for: Voice conversation, Text-to-Speech, voice cloning
#
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ============================================================================
# QDRANT (OPTIONAL - for tactics database)
# ============================================================================
# Get your cluster from: https://cloud.qdrant.io/
# Used for: Vector search of negotiation tactics
# Note: App will work without Qdrant
#
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here

# ============================================================================
# SETUP CHECKLIST
# ============================================================================
# [ ] 1. Copy this file to .env
# [ ] 2. Get Mistral API key from https://console.mistral.ai/
# [ ] 3. Get ElevenLabs API key from https://elevenlabs.io/
# [ ] 4. (Optional) Get Qdrant cluster from https://cloud.qdrant.io/
# [ ] 5. Replace placeholder values above with real keys
# [ ] 6. Rebuild Docker: docker compose down && docker compose up --build
# [ ] 7. Check logs: docker compose logs backend | grep "initialized"
#
# See API_KEYS_SETUP.md for detailed instructions!
# ============================================================================
