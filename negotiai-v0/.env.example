# =============================================================================
# NegotiAI v0 - Configuration Exemple
# =============================================================================
# Copiez ce fichier vers .env et remplissez avec vos vraies clés API

# -----------------------------------------------------------------------------
# MISTRAL AI
# -----------------------------------------------------------------------------
# Obtenir votre clé : https://console.mistral.ai/
# Utilisé pour : Recherche entreprise + Analyse des négociations
MISTRAL_API_KEY=your_mistral_key_here

# -----------------------------------------------------------------------------
# QDRANT (Vector Database)
# -----------------------------------------------------------------------------
# Obtenir : https://cloud.qdrant.io/
# Utilisé pour : Stockage des tactiques de négociation (optionnel pour la démo)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here

# -----------------------------------------------------------------------------
# ELEVENLABS (Conversational AI)
# -----------------------------------------------------------------------------
# Obtenir votre clé : https://elevenlabs.io/
# Utilisé pour : Agent vocal IA qui négocie par téléphone
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Phone Number ID pour les appels sortants
# Obtenir : ElevenLabs Dashboard → Conversational AI → Phone Numbers
# Format : phnum_xxxxxxxxxxxxxxxxxxxxx
# ⚠️ CRITIQUE : Sans cela, les appels ne fonctionneront PAS
ELEVENLABS_AGENT_PHONE_NUMBER_ID=phnum_01jwgc4x8zfjk9f0632bw7kpz7

# -----------------------------------------------------------------------------
# WEBHOOK (Pour recevoir les callbacks ElevenLabs)
# -----------------------------------------------------------------------------
# Pour développement local : Utilisez ngrok
# 1. Lancez ngrok : ngrok http 8000
# 2. Copiez l'URL HTTPS (ex: https://abc123.ngrok-free.app)
# 3. Mettez-la ci-dessous (SANS le slash final)
#
# Pour production : Utilisez votre URL de backend déployée
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app

# -----------------------------------------------------------------------------
# NOTES IMPORTANTES
# -----------------------------------------------------------------------------
#
# 1. Ne commitez JAMAIS ce fichier .env dans git !
#    Le .gitignore est configuré pour l'ignorer.
#
# 2. Pour tester rapidement :
#    - Mistral : Utilisez mistral-small-latest (moins cher)
#    - ElevenLabs : Chaque appel coûte ~0.10-0.20€
#    - Qdrant : Le tier gratuit suffit largement
#
# 3. Après avoir modifié ce fichier, redémarrez Docker :
#    docker-compose restart backend
#
# 4. Pour vérifier que tout fonctionne :
#    docker-compose logs backend | grep "✅"
#    Vous devriez voir :
#    ✅ Mistral service initialized
#    ✅ Phone Call Handler initialized (with phone number)
#    ✅ Webhook configured: https://...
